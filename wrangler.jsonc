{
  "name": "ntu-sched",
  "main": "src/worker.mjs",
  "account_id": "56ed116482d3c27b6980d1d13dff17c8",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-week",
      "database_id": "5a1827e5-152d-42d4-bb93-23c4705fa4f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://ntu-sched.s20gamingfake.workers.dev",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "NTU_LOGIN_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "previews": {
    "vars": {
      "APP_ORIGIN": "https://preview.invalid",
      "NTU_LOGIN_ENABLED": "false"
    },
    "d1_databases": []
  }
}

