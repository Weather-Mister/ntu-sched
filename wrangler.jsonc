{
  "name": "campus-week-api",
  "main": "src/worker.mjs",
  "account_id": "56ed116482d3c27b6980d1d13dff17c8",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "campus-week",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_CAMPUS_WEEK_HOST",
    "NTU_LOGIN_ENABLED": "false"
  },
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": false }
}
